---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';

const skills = ['C++23', 'Vulkan', 'OpenGL', 'GLSL', 'Slang', 'Engine architecture', 'GPU-driven rendering', 'Data-oriented design'];

const projects = [
    {
        label: 'Current focus',
        title: 'Synapse Engine',
        text: 'A research- and education-oriented, fully GPU-driven engine in C++23 and Vulkan 1.4. Custom data-oriented ECS, four-level GPU culling with task and mesh shaders, a virtual shadow atlas, and my own Dual-HiZ Adaptive Clustered Forward+ lighting technique.',
        img: '/Images/About/Synapse.png',
        links: [
            { href: '/', label: 'Project page', primary: true },
            { href: 'https://github.com/TamasPetii/SynapseEngine', label: 'Source code' },
        ],
    },
    {
        label: 'B.Sc. thesis',
        title: 'Dendrite Engine',
        text: 'My OpenGL-based game engine, built as my Bachelor’s thesis. It was my first deep dive into engine architecture, rendering pipelines and memory management, and the experience it gave me became the foundation for Synapse Engine.',
        img: '/Images/About/Dendrite.png',
        links: [{ href: 'https://github.com/TamasPetii/DendriteEngine', label: 'Source code' }],
    },
    {
        label: 'University team project',
        title: 'CityBuilder3D',
        text: 'A 3D city simulation game developed in a team during my B.Sc. studies: grid-based building placement, background resource management and an architecture designed to simulate and render a growing city.',
        img: '/Images/About/CityBuilder.jpg',
        links: [{ href: 'https://github.com/TamasPetii/CityBuilder3D', label: 'Source code' }],
    },
    {
        label: 'Unity · C#',
        title: 'Strategy Quiz Game',
        text: 'A team project in Unity built on an event-driven Model-View-Controller architecture, with a focus on clean separation of concerns, custom card UI animations and a workable collaborative workflow.',
        img: '/Images/About/QuizGame.png',
        links: [{ href: 'https://github.com/Szoftverarchitekturak-Csepeli-Gang/QuizGame', label: 'Source code' }],
    },
];
---

<Layout title="About | Péter Tamás">

    <!-- ============================== HERO (full screen) ============================== -->
    <section class="relative isolate overflow-hidden min-h-[calc(100svh-4rem)] flex flex-col">
        <div class="absolute inset-0 -z-10 bg-[url('/Images/About/Bistro.png')] bg-cover bg-center opacity-25 dark:opacity-25"></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-bg/60 via-bg/80 to-bg"></div>

        <div class="wrap flex-1 flex items-center py-20">
            <div class="grid w-full gap-10 lg:gap-16 lg:grid-cols-12 items-center">
                <div class="lg:col-span-4 flex lg:justify-center">
                    <img src="/Images/Profile.png" alt="Péter Tamás" width="256" height="256" class="profile-photo rounded-full object-cover border border-line" />
                </div>

                <div class="lg:col-span-8">
                    <p class="eyebrow mb-4">About</p>
                    <h1 class="text-4xl md:text-6xl font-semibold tracking-[-0.03em] leading-[1.05]"><span class="font-extrabold">Péter</span> Tamás</h1>
                    <p class="mt-3 text-lg text-muted">Graphics programmer and engine developer</p>

                    <div class="mt-8 max-w-2xl space-y-5 body text-[17px]">
                        <p>
                            Hi, I'm Péter. I study at the Budapest University of Technology and Economics, where I'm doing two
                            master's programs at once. Computer Engineering, specialising in Visual Informatics, and Computer
                            Science Teacher.
                        </p>
                        <p>
                            I've always been curious about how the big engines really work. What happens under the hood, which
                            algorithms make it all possible and how the pieces fit together. What fascinates me most is the
                            GPU-driven way of thinking, and high-performance algorithms that get the most out of modern hardware.
                        </p>
                        <p>
                            That curiosity turned into <a href="/" class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg">Synapse Engine</a>.
                            It started as a way to really understand these techniques, and grew into an open-source engine for
                            research and education. It's also where I try out my own ideas, like the Dual-HiZ Adaptive Clustered
                            Forward+ technique.
                        </p>
                    </div>

                    <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-faint">
                        {skills.map((s) => <span>{s}</span>)}
                    </div>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href="https://github.com/TamasPetii" target="_blank" rel="noopener" class="btn-secondary bg-bg/60 backdrop-blur-sm">GitHub</a>
                        <a href="https://www.linkedin.com/in/tamaspeti/" target="_blank" rel="noopener" class="btn-secondary bg-bg/60 backdrop-blur-sm">LinkedIn</a>
                        <a href="mailto:contact@synapseengine.dev" class="btn-secondary bg-bg/60 backdrop-blur-sm">Email</a>
                    </div>
                </div>
            </div>
        </div>

        <a href="#projects" class="mx-auto pb-8 flex flex-col items-center gap-1.5 text-xs text-faint hover:text-fg transition-colors">
            Projects
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m0 0-6-6m6 6 6-6"/></svg>
        </a>
    </section>

    <section id="projects" class="border-y border-line bg-surface scroll-mt-16">
      <div class="wrap py-20 md:py-28">
        <div class="flex items-end justify-between border-b border-line pb-5 mb-4">
            <h2 class="h-sub">Projects</h2>
            <a href="https://github.com/TamasPetii" target="_blank" rel="noopener" class="link">All repositories ↗</a>
        </div>

        <div class="divide-y divide-line">
            {projects.map((p) => (
                <article class="grid gap-8 md:grid-cols-12 py-12 items-center">
                    <div class="md:col-span-7">
                        <Figure src={p.img} alt={p.title} crop />
                    </div>
                    <div class="md:col-span-5">
                        <p class="eyebrow mb-3">{p.label}</p>
                        <h3 class="text-2xl font-semibold tracking-tight mb-3">{p.title}</h3>
                        <p class="body mb-6">{p.text}</p>
                        <div class="flex flex-wrap gap-3">
                            {p.links.map((l) => (
                                <a href={l.href}
                                   target={l.href.startsWith('http') ? '_blank' : undefined}
                                   rel={l.href.startsWith('http') ? 'noopener' : undefined}
                                   class={l.primary ? 'btn-primary' : 'btn-secondary'}>
                                    {l.label}
                                </a>
                            ))}
                        </div>
                    </div>
                </article>
            ))}
        </div>
      </div>
    </section>

</Layout>

<style>
    .profile-photo {
        width: 10rem;
        height: 10rem;
        max-width: none;
    }
    @media (min-width: 1024px) {
        .profile-photo {
            width: 16rem;
            height: 16rem;
        }
    }
</style>
