---
import Layout from '../layouts/Layout.astro';

const SPONSOR_URL = 'https://github.com/sponsors/TamasPetii';

const monthly = [
    { name: 'Supporter', price: '$4', text: 'A small monthly thank you. It helps more than you would think.' },
    { name: 'Backer', price: '$12', text: 'Helps cover hardware, tools and the time that goes into benchmarks and testing.' },
    { name: 'Sponsor', price: '$29', text: 'Gives me more time for the devblog, documentation and learning material.' },
    { name: 'Studio or lab', price: '$99', text: 'For studios, companies and research groups who use the engine or want it to keep growing.' },
];

const oneTime = [
    { name: 'Thank you', price: '$5', text: 'If a talk, a devblog post or a piece of code helped you.' },
    { name: 'Big thank you', price: '$25', text: 'Supports the time behind the engine and the material around it.' },
    { name: 'Generous support', price: '$100', text: 'A larger one-time contribution to the development of the engine.' },
];
---

<Layout title="Sponsor | Synapse Engine">

    <!-- ============================== HERO (full screen) ============================== -->
    <section class="relative isolate overflow-hidden min-h-[calc(100svh-4rem)] flex flex-col">
        <div class="absolute inset-0 -z-10 bg-[url('/Images/Sponsor/Miguel.png')] bg-cover bg-center opacity-25 dark:opacity-25"></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-bg/60 via-bg/80 to-bg"></div>

        <div class="wrap flex-1 flex flex-col justify-center py-20">
            <p class="eyebrow mb-6">Sponsor</p>
            <h1 class="max-w-4xl text-5xl md:text-7xl font-semibold tracking-[-0.035em] leading-[1.02]">Support the project</h1>

            <div class="mt-10 grid gap-x-12 gap-y-5 md:grid-cols-2 max-w-5xl body text-[17px]">
                <p>
                    Synapse Engine is open source and free, and it will stay that way. Today it is released under the AGPL
                    license, and in the future I will most likely move to a more permissive one.
                </p>
                <p>
                    Sponsoring is completely optional. Building this engine took an enormous amount of time, energy and
                    struggle, so if you decide to support it, thank you. It really means a lot.
                </p>
            </div>

            <div class="mt-10 flex flex-wrap gap-3">
                <a href={SPONSOR_URL} target="_blank" rel="noopener" class="btn-primary">Sponsor on GitHub</a>
                <a href="#tiers" class="btn-secondary bg-bg/60 backdrop-blur-sm">See the options</a>
            </div>
            <p class="mt-6 text-sm text-faint">There are no perks and no paywalls. Everything stays free for everyone.</p>
        </div>
    </section>

    <!-- ============================== TIERS ============================== -->
    <section id="tiers" class="border-y border-line bg-surface scroll-mt-16">
        <div class="wrap py-20 md:py-24">
            <h2 class="h-sub mb-2">Monthly</h2>
            <p class="body mb-8">Recurring support through GitHub Sponsors. You can cancel any time.</p>
            <div class="grid gap-px bg-line border border-line rounded-lg overflow-hidden sm:grid-cols-2 lg:grid-cols-4">
                {monthly.map((t) => (
                    <div class="bg-bg p-6 flex flex-col">
                        <span class="font-mono text-2xl font-medium mb-5">{t.price}<span class="text-sm text-faint"> / month</span></span>
                        <h3 class="font-semibold mb-2">{t.name}</h3>
                        <p class="text-sm leading-relaxed text-muted mb-6 flex-1">{t.text}</p>
                        <a href={SPONSOR_URL} target="_blank" rel="noopener" class="btn-secondary w-full">Choose</a>
                    </div>
                ))}
            </div>

            <h2 class="h-sub mt-16 mb-2">One-time</h2>
            <p class="body mb-8">A single contribution, also through GitHub Sponsors.</p>
            <div class="grid gap-px bg-line border border-line rounded-lg overflow-hidden md:grid-cols-3">
                {oneTime.map((t) => (
                    <div class="bg-bg p-6 flex flex-col">
                        <span class="font-mono text-2xl font-medium mb-5">{t.price}</span>
                        <h3 class="font-semibold mb-2">{t.name}</h3>
                        <p class="text-sm leading-relaxed text-muted mb-6 flex-1">{t.text}</p>
                        <a href={SPONSOR_URL} target="_blank" rel="noopener" class="btn-secondary w-full">Support once</a>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ============================== SPONSORS ============================== -->
    <section class="wrap pt-20 md:pt-24">
        <div class="grid gap-6 lg:grid-cols-12">
            <h2 class="lg:col-span-5 h-sub">Sponsors</h2>
            <div class="lg:col-span-7">
                <p class="body mb-6">Thank you to everyone who supports the project.</p>
                <p class="text-sm text-faint border border-dashed border-line rounded-lg px-5 py-6">No sponsors yet. Yours could be the first name here.</p>
            </div>
        </div>
    </section>
</Layout>
