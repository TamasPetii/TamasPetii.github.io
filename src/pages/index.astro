---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import SparseSet from '../components/diagrams/SparseSet.astro';
import Segments from '../components/diagrams/Segments.astro';

const IMG = '/Images/Home';
const DEEP_DIVE = '/Presentations/SynapseEnginePresentation.pdf';
const DHAC_TALK = '/Presentations/Budapest_Graphics_Forum_2026_DHAC.pdf';
const DHAC_CODE = 'https://github.com/TamasPetii/SynapseEngine/tree/feature/paper/SynapseEngine/Engine/Shaders/Passes/Shading/ForwardPlus/Techniques';
const DHAC_BENCHMARK_POST = '/devblog';

const landscapeCols = ['Open source', 'Modern GPU-driven pipeline', 'Complete engine architecture', 'Built for research', 'Transparent for research'];

const landscape = [
    { name: 'Unity Engine',  v: ['no', 'part', 'yes', 'no', 'no'] },
    { name: 'Northlight',    v: ['no', 'yes', 'yes', 'no', 'no'] },
    { name: 'Unreal Engine', v: ['part', 'yes', 'yes', 'no', 'part'] },
    { name: 'Godot Engine',  v: ['yes', 'part', 'yes', 'no', 'part'] },
    { name: 'Wicked Engine', v: ['yes', 'part', 'yes', 'no', 'part'] },
    { name: 'NVIDIA Falcor', v: ['yes', 'part', 'no', 'yes', 'yes'] },
];

const audiences = [
    {
        tag: 'Research',
        title: 'University research groups',
        text: 'A modern, high-performance engine on Vulkan 1.4 and its newest extensions, ready to use. No need for every group to maintain its own framework.',
        goal: 'The long-term goal is a shared benchmark platform. Many research algorithms implemented in one engine, measured under the same conditions and citable in papers.',
    },
    {
        tag: 'Industry R&D',
        title: 'Companies and R&D teams',
        text: 'A clean, lean engine for prototyping new rendering ideas fast, without fighting a huge codebase first.',
        goal: 'Try an algorithm, measure it, change it. Then take what works to your production engine.',
    },
    {
        tag: 'Education',
        title: 'Students and graphics enthusiasts',
        text: 'Not just Vulkan, but how a complete modern engine is built. Clean code, clear layers and state-of-the-art graphics techniques.',
        goal: 'I am planning a lot of learning material and visual devblogs to go with the code.',
    },
];

const dhacBench = [
    { name: 'DHAC', config: 'Dual-HiZ, 16 slices', tile: '32×32', ms: 3.083, speedup: '1.00×', ours: true },
    { name: 'DHAC-', config: 'No Hi-Z, 8×8 threads', tile: '32×32', ms: 3.375, speedup: '1.09×', ours: true },
    { name: 'DOOM (2016)', config: '32 slices', tile: '64×64', ms: 5.480, speedup: '1.78×' },
    { name: 'Wicked Engine', config: '8×8 threads', tile: '8×8', ms: 6.923, speedup: '2.25×' },
    { name: 'Harada et al.', config: '16×16 threads', tile: '16×16', ms: 7.671, speedup: '2.49×' },
];

const dhacMax = Math.max(...dhacBench.map((b) => b.ms));

const dhacLinks = [
    { kind: 'Devblog', title: 'Detailed benchmark', text: 'Every technique, tile size and run parameter.', href: DHAC_BENCHMARK_POST },
    { kind: 'Talk · PDF', title: 'Budapest Graphics Forum 2026', text: 'The full method, explained step by step.', href: DHAC_TALK },
    { kind: 'GitHub', title: 'Source code', text: 'The Forward+ techniques in the engine.', href: DHAC_CODE },
];

/* ---------- Data for the sections below the divider (not reworked yet) ---------- */

const cullingLevels = [
    {
        level: 'Model',
        text: 'Each model is tested by its own thread. Simple models are finished right here, complex ones move on to the next pass.',
        img: 'Culling_NoMesh.png',
        caption: 'After model culling',
    },
    {
        level: 'Mesh',
        text: 'A group of 32 threads works on one model together. They test every mesh, pick the LOD and write the indirect draw commands.',
        img: 'Culling_NoMeshlet.png',
        caption: 'After mesh culling',
    },
    {
        level: 'Meshlet',
        text: 'The task shader tests every meshlet. Only the meshlets that survive launch mesh shader work.',
        img: 'Culling_Result.png',
        caption: 'After meshlet culling, the final result',
    },
];

const cullingTests = [
    {
        name: 'Frustum',
        text: 'A cheap sphere test runs first, the box test only when needed. Objects fully inside are flagged, so their meshes and meshlets skip the test.',
        img: 'Culling_Frustum.png',
    },
    {
        name: 'Occlusion',
        text: 'Bounds are tested against a Hi-Z depth pyramid built from the previous frame. Anything hidden behind other geometry is dropped.',
        img: 'Culling_Occlusion.png',
    },
    {
        name: 'Contribution',
        text: 'Objects that cover too few pixels on screen are dropped before any depth is read. The threshold can be tuned per scene.',
        img: 'Culling_Contribution.png',
    },
    {
        name: 'Cone',
        text: 'Every meshlet stores a cone of its normals. If the cone faces away from the camera, the meshlet is skipped.',
        img: 'Culling_Cone.png',
    },
];

// TDK tables 4.3 and 4.4: model culling and full GPU time by entity count
const scalingGpus = [
    {
        gpu: 'RTX 4060',
        rows: [
            { n: '10,000', model: 0.013, total: 0.253 },
            { n: '100,000', model: 0.050, total: 0.549 },
            { n: '1,000,000', model: 0.360, total: 0.671, hl: true },
            { n: '2,000,000', model: 0.680, total: 0.992 },
        ],
    },
    {
        gpu: 'RTX 4070 SUPER',
        rows: [
            { n: '10,000', model: 0.009, total: 0.140 },
            { n: '100,000', model: 0.036, total: 0.285 },
            { n: '1,000,000', model: 0.223, total: 0.406, hl: true },
            { n: '2,000,000', model: 0.404, total: 0.578 },
        ],
    },
];

// TDK table 4.1: CPU-driven vs GPU-driven culling, 1M entities
const cpuVsGpu = [
    { name: 'CPU-driven culling', cpu: 12.244, gpu: null, fps: 79, strong: true },
    { name: 'with full mesh shader path', cpu: null, gpu: 3.481, fps: null, sub: true },
    { name: 'with mesh shaders, no occlusion', cpu: null, gpu: 4.504, fps: null, sub: true },
    { name: 'with vertex shaders', cpu: null, gpu: 7.687, fps: null, sub: true },
    { name: 'GPU-driven culling', cpu: 0.153, gpu: 0.677, fps: 1344, strong: true, hl: true },
];

// TDK table 4.2: cumulative visibility tests, 1M entities
const cumulative = [
    { stage: 'No culling', ms: 124.407 },
    { stage: '+ Cone culling', ms: 94.123 },
    { stage: '+ Hierarchical frustum culling', ms: 2.878 },
    { stage: '+ Hierarchical Hi-Z occlusion culling', ms: 0.681 },
    { stage: '+ Dynamic LOD selection', ms: 0.653, hl: true },
];

// TDK tables 4.5 to 4.8: three-level vs four-level (Morton chunk) culling
const mortonScenes = [
    {
        title: '10M entities, heavily occluded',
        rows: [
            { stage: 'Reset commands', a: 0.006, b: 0.005 },
            { stage: 'Morton chunk culling', a: null, b: 0.069 },
            { stage: 'Morton model culling', a: null, b: 0.164 },
            { stage: 'Model culling', a: 5.885, b: 0.005 },
            { stage: 'Mesh culling', a: 0.003, b: 0.003 },
            { stage: 'Total', a: 5.908, b: 0.264, hl: true },
        ],
    },
    {
        title: '2.5M entities, high visible load',
        rows: [
            { stage: 'Reset commands', a: 0.008, b: 0.007 },
            { stage: 'Morton chunk culling', a: null, b: 0.021 },
            { stage: 'Morton model culling', a: null, b: 0.972 },
            { stage: 'Model culling', a: 1.796, b: 0.005 },
            { stage: 'Mesh culling', a: 0.018, b: 0.018 },
            { stage: 'Total', a: 1.823, b: 1.023, hl: true },
        ],
    },
];

const cullingLinks = [
    { kind: 'Technical deep dive', title: 'Pages 114 to 150', text: 'GPU-driven rendering and the full culling pipeline.', href: `${DEEP_DIVE}#page=114` },
    { kind: 'GitHub', title: 'Source code', text: 'The geometry culling passes in the engine.', href: 'https://github.com/TamasPetii/SynapseEngine/tree/main/SynapseEngine/Engine/Shaders/Passes/Culling/Geometry' },
];

const ms = (v: number | null, d = 3) => (v === null ? '' : `${v.toFixed(d)} ms`);

// TDK figure 3.4, split into its four steps
const meshSteps = [
    { title: 'The scene', text: 'Only a small part of the dragon is visible from the camera.', img: 'Mesh_Scene.png' },
    { title: 'Vertex shader', text: 'Every vertex of the mesh is still read and transformed, visible or not.', img: 'Mesh_VertexShader.png' },
    { title: 'Task shader', text: 'Each meshlet is tested first. Hidden meshlets are dropped before a single vertex is read.', img: 'Mesh_TaskShader.png' },
    { title: 'Mesh shader', text: 'Only the triangles of the visible meshlets are processed and rasterized.', img: 'Mesh_MeshShader.png' },
];

// TDK figure 3.7
const lodShots = [
    { img: 'LOD0_Meshlets.png', caption: 'LOD0, full detail, meshlets' },
    { img: 'LOD0_Triangles.png', caption: 'LOD0, full detail, triangles' },
    { img: 'LOD3_Meshlets.png', caption: 'LOD3, 12.5% detail, meshlets' },
    { img: 'LOD3_Triangles.png', caption: 'LOD3, 12.5% detail, triangles' },
];

const shadowLights = [
    {
        name: 'Directional light',
        text: [
            'A directional light covers the whole view, so the camera frustum is split into four cascades. Each cascade works like its own light and gets its own region in the atlas.',
            'Static and dynamic objects go into two separate atlases. The static one is only redrawn when something static changes or the light moves. The shader reads both, so nothing has to be copied between them.',
        ],
        atlas: 'Shadow_DirAtlas.png',
        result: 'Shadow_DirResult.png',
    },
    {
        name: 'Spot light',
        text: [
            'A spot light gets one region in the atlas. Its size follows how big the light is on screen, from 512 × 512 close to the camera down to 64 × 64 far away.',
            'Objects are tested against the real cone of the light, so only geometry inside the cone is drawn into its region.',
        ],
        atlas: 'Shadow_SpotAtlas.png',
        result: 'Shadow_SpotResult.png',
    },
    {
        name: 'Point light',
        text: [
            'A point light looks in six directions. Instead of cube maps, the six faces are laid out in a 2 × 3 grid inside the atlas.',
            'Objects are tested against the light sphere first, then against each of the six face frustums. A face only draws the objects it can really see.',
        ],
        atlas: 'Shadow_PointAtlas.png',
        result: 'Shadow_PointResult.png',
    },
];

const mortonLinks = [
    { kind: 'Technical deep dive', title: 'Pages 135 to 139', text: 'How the Morton chunk hierarchy is built on the GPU.', href: `${DEEP_DIVE}#page=135` },
    { kind: 'GitHub', title: 'Source code', text: 'The Morton code, sorting and chunk building passes.', href: 'https://github.com/TamasPetii/SynapseEngine/tree/main/SynapseEngine/Engine/Shaders/Passes/Morton' },
];

const meshLinks = [
    { kind: 'Technical deep dive', title: 'Pages 95 to 98', text: 'Meshlets, task shaders and mesh shaders.', href: `${DEEP_DIVE}#page=95` },
    { kind: 'GitHub', title: 'Source code', text: 'The task and mesh shaders in the engine.', href: 'https://github.com/TamasPetii/SynapseEngine/tree/main/SynapseEngine/Engine/Shaders/Passes/Shading/Common' },
];

const shadowLinks = [
    { kind: 'Technical deep dive', title: 'Pages 193 to 219', text: 'The full shadow pipeline, step by step.', href: `${DEEP_DIVE}#page=193` },
    { kind: 'GitHub', title: 'Shadow culling', text: 'Culling passes for every light type.', href: 'https://github.com/TamasPetii/SynapseEngine/tree/main/SynapseEngine/Engine/Shaders/Passes/Culling' },
    { kind: 'GitHub', title: 'Shadow rendering', text: 'Atlas rendering and shadow passes.', href: 'https://github.com/TamasPetii/SynapseEngine/tree/main/SynapseEngine/Engine/Shaders/Passes/Shadow' },
];

/* ---------- ECS ---------- */

const ecsProps = [
    { title: 'O(1) access', text: 'The sparse array maps an entity ID straight to its component. No hashing, no search.' },
    { title: 'Cache friendly', text: 'Components of one type are packed together, so the CPU reads them in one straight line.' },
    { title: 'Fast add and remove', text: 'Adding appends to the end. Removing swaps in the last element, so there are never holes.' },
    { title: 'SIMD friendly', text: 'Tightly packed plain data is ideal for vectorized processing.' },
    { title: 'Parallel systems', text: 'About thirty systems run as a Taskflow dependency graph. Independent systems run at the same time on every core.' },
    { title: 'Ready for the GPU', text: 'Dense arrays are copied to GPU memory as they are, without any conversion.' },
];

const ecsSegments = [
    { key: 'static', name: 'Static', text: 'Rarely changes, like level geometry. Updated only through a dedicated list. Morton chunks and static shadows build on it.' },
    { key: 'dynamic', name: 'Dynamic', text: 'Changes now and then. Change flags mark what was touched, and untouched blocks are skipped.' },
    { key: 'stream', name: 'Stream', text: 'Changes every frame. Simply processed every frame, no tracking needed.' },
];

const ecsLinks = [
    { kind: 'Technical deep dive', title: 'Pages 8 to 40', text: 'The ECS, the segmented pools and the template design.', href: `${DEEP_DIVE}#page=8` },
    { kind: 'GitHub', title: 'Source code', text: 'The registry and component pools.', href: 'https://github.com/TamasPetii/SynapseEngine/tree/main/SynapseEngine/Engine/Registry' },
];

/* ---------- Architecture ---------- */

const modelStages = [
    { name: 'Raw model', text: 'Loaded from a file through Assimp or TinyObj, or generated procedurally, like cubes, spheres and Bézier surfaces.' },
    { name: 'Cooked model', text: 'Normals, tangents and colliders are generated. LOD levels and meshlets are built with meshoptimizer.' },
    { name: 'GPU model', text: 'Converted into the GPU layout and uploaded, ready for the GPU-driven pipeline.' },
    { name: 'CPU model', text: 'A CPU-side copy for engine systems that need the geometry on the CPU, with welded vertices and batched indices.' },
];

const archLinks = [
    { kind: 'Technical deep dive', title: 'Pages 41 to 55', text: 'The layered architecture and the model pipeline.', href: `${DEEP_DIVE}#page=41` },
    { kind: 'GitHub', title: 'Source code', text: 'The mesh and model pipeline.', href: 'https://github.com/TamasPetii/SynapseEngine/tree/main/SynapseEngine/Engine/Mesh' },
];

/* ---------- MVI and editor ---------- */

const editorLayers = [
    { name: 'Editor', role: 'View', text: 'Windows, viewports and controls. It draws the state it gets and turns user actions into intents.' },
    { name: 'EditorCore', role: 'ViewModel', text: 'State, intents and business logic for every editor window. It knows nothing about the UI framework.' },
    { name: 'Engine', role: 'Data', text: 'The runtime itself. ECS, renderer, Vulkan resources, physics and asset managers.' },
];

const editors = [
    { img: 'Editor_Material.png', name: 'Materials', text: 'Create and tune materials with a live preview.' },
    { img: 'Editor_Model.png', name: 'Models', text: 'Inspect imported and procedural models.' },
    { img: 'Editor_Texture.png', name: 'Textures', text: 'Browse and check textures.' },
    { img: 'Editor_Animation.png', name: 'Animation', text: 'Preview skeletal animations.' },
    { img: 'Editor_Audio.png', name: 'Audio', text: 'Listen to sounds and see their waveform.' },
];

const editorLinks = [
    { kind: 'Technical deep dive', title: 'Pages 56 to 65', text: 'The MVI architecture and the editor.', href: `${DEEP_DIVE}#page=56` },
    { kind: 'GitHub', title: 'Source code', text: 'EditorCore, the ViewModels and intents.', href: 'https://github.com/TamasPetii/SynapseEngine/tree/main/SynapseEngine/EditorCore' },
];

const ecsBench = [
    { op: 'Add', s: 59.66, e: 35.59 },
    { op: 'Remove', s: 26.18, e: 37.01 },
    { op: 'Iterate (sequential)', s: 2.46, e: 2.25 },
    { op: 'Iterate (parallel)', s: 2.15, e: 2.26 },
    { op: 'Full engine update', s: 1.15, e: 1.76 },
];

// IDK thesis, tables 6.1 and 6.2
const requirements = [
    {
        group: 'Hardware',
        rows: [
            ['Graphics API', 'Vulkan 1.4 with an up-to-date driver'],
            ['Minimum GPU', 'NVIDIA RTX 20 series or newer'],
            ['Tested GPUs', 'RTX 4050 Laptop, RTX 4060, RTX 4070 SUPER'],
            ['AMD and Intel', 'Validation in progress'],
            ['Vulkan features', 'Buffer device address, bindless resources, descriptor buffer, shader objects, task and mesh shaders, dynamic rendering'],
            ['CPU', 'Modern multi-core x86-64 with AVX2. More cores help the parallel systems.'],
            ['Memory', 'No fixed minimum. It depends on the scene and the techniques in use.'],
        ],
    },
    {
        group: 'Development',
        rows: [
            ['Language', 'C++23 and GLSL'],
            ['Platforms', 'Tested on Windows and Linux'],
            ['Build system', 'Xmake, with dependencies built by vcpkg'],
            ['Compiler', 'MSVC recommended on Windows, Clang and GCC also work'],
            ['Configurations', 'debug, release, dist, performance'],
            ['Sample assets', 'Downloaded automatically from the GitHub release if missing'],
        ],
    },
    {
        group: 'Size',
        rows: [
            ['Repository', 'About 3.5 GB with the sample models and assets'],
            ['Full build', 'About 34 GB, of which about 21 GB are vcpkg dependencies'],
            ['Runtime', 'About 180 MB for the executable and its binaries'],
        ],
    },
];

const talks = [
    { date: 'Dec 2026', kind: 'MSc thesis', title: 'Master’s thesis', venue: 'BME VIK', lang: 'HU', soon: true },
    { date: 'Nov 2026', kind: 'Thesis', title: 'High-performance GPU-driven rendering techniques on next-generation graphics hardware', venue: 'Scientific Students’ Association (TDK), BME VIK', lang: 'HU', soon: true },
    { date: 'Nov 2026', kind: 'Thesis', title: 'Synapse Engine, a high-performance open-source engine for research and education', venue: 'Innovation TDK (IDK), BME VIK', lang: 'HU', soon: true },
    { date: 'Oct 2026', kind: 'Talk', title: 'Dual-HiZ Adaptive Clustered Forward+', venue: 'Budapest Graphics Forum 2026, October 14', lang: 'EN', href: '/Presentations/Budapest_Graphics_Forum_2026_DHAC.pdf' },
    { date: 'Aug 2026', kind: 'Deep dive', title: 'Synapse Engine technical deep dive', venue: '250 pages', lang: 'EN', href: '/Presentations/SynapseEnginePresentation.pdf' },
    { date: 'May 2026', kind: 'Paper', title: 'High-Performance GPU-Driven Rendering', venue: 'GRAFGEO, Hungarian Conference on Computer Graphics and Geometry', lang: 'EN', href: '/Presentations/Grafgeo_High_Performance_Gpu_Driven_Rendering.pdf' },
    { date: 'May 2026', kind: 'Talk', title: 'High-Performance GPU-Driven Rendering', venue: 'GRAFGEO conference presentation', lang: 'HU', href: '/Presentations/BEMUTATO_GRAFGEO_TAMAS_PETER.pdf' },
    { date: 'Earlier', kind: 'Slides', title: 'Synapse Engine v1.1', venue: 'University Project Laboratory 2, BME', lang: 'HU', href: '/Presentations/SynapseEngine_v1.1.pdf' },
    { date: 'Earlier', kind: 'Slides', title: 'Synapse Engine v1.0', venue: 'University Project Laboratory, BME', lang: 'HU', href: '/Presentations/SynapseEngine_v1.0.pdf' },
