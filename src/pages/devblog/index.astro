---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Posts are numbered by file name (01-..., 02-...), oldest first.
// The list shows the newest post on top.
const posts = (await getCollection('devblog'))
    .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }))
    .map((post, i) => ({
        post,
        number: String(i + 1).padStart(2, '0'),
        slug: post.id.replace(/\.[^/.]+$/, ''),
    }))
    .reverse();
---

<Layout title="Devblog | Synapse Engine">
    <section class="wrap pt-16 md:pt-24">
        <p class="eyebrow mb-4">Devblog</p>
        <h1 class="text-4xl md:text-5xl font-semibold tracking-[-0.03em] leading-[1.05] mb-14">Development notes</h1>

        <ol class="border-t border-line">
            {posts.map(({ post, number, slug }) => (
                <li class="border-b border-line">
                    <a href={`/devblog/${slug}`} class="group grid gap-5 md:gap-8 md:grid-cols-12 items-center py-8 -mx-3 px-3 rounded-md hover:bg-surface transition-colors">
                        <div class="md:col-span-4">
                            {post.data.cover ? (
                                <img src={post.data.cover} alt="" loading="lazy" class="w-full aspect-[16/10] object-cover rounded-lg border border-line bg-surface" />
                            ) : (
                                <div class="w-full aspect-[16/10] rounded-lg border border-line bg-surface flex items-center justify-center">
                                    <span class="font-mono text-4xl text-faint">{number}</span>
                                </div>
                            )}
                        </div>
                        <div class="md:col-span-6">
                            <span class="font-mono text-xs text-faint">{number}</span>
                            <h2 class="mt-2 text-xl md:text-2xl font-semibold tracking-tight mb-2 group-hover:underline underline-offset-4 decoration-line">{post.data.title}</h2>
                            <p class="body text-[15px]">{post.data.description}</p>
                        </div>
                        <div class="md:col-span-2 md:text-right text-sm text-faint">
                            <div>{post.data.pubDate}</div>
                            <div class="font-mono text-xs mt-1">{post.data.tags.join(' · ')}</div>
                        </div>
                    </a>
                </li>
            ))}
        </ol>
    </section>
</Layout>
