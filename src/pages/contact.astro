---
import Layout from '../layouts/Layout.astro';

const EMAIL = 'contact@synapseengine.dev';

const channels = [
    {
        label: 'GitHub',
        value: '@TamasPetii',
        href: 'https://github.com/TamasPetii',
        icon: 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z',
    },
    {
        label: 'LinkedIn',
        value: 'Tamás Péter',
        href: 'https://www.linkedin.com/in/tamaspeti/',
        icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    },
    {
        label: 'X',
        value: '@SynapseEngine',
        href: 'https://x.com/SynapseEngine',
        icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
    },
    {
        label: 'Discord',
        value: 'Coming soon',
        icon: 'M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z',
    },
];

const reasons = [
    {
        tag: 'Research',
        title: 'Collaboration',
        text: 'Working on a rendering technique and want to implement or benchmark it in Synapse Engine? I would love to hear about it.',
    },
    {
        tag: 'Education',
        title: 'Courses and theses',
        text: 'If you want to use the engine in a course, a lab or a thesis, write to me and we can figure out how it fits.',
    },
    {
        tag: 'Questions',
        title: 'Techniques and feedback',
        text: 'Questions about an algorithm, the devblog or the code are always welcome. For bugs, a GitHub issue works best.',
    },
];
---

<Layout title="Contact | Synapse Engine">

    <!-- ============================== HERO (full screen) ============================== -->
    <section class="relative isolate overflow-hidden min-h-[calc(100svh-4rem)] flex flex-col">
        <div class="absolute inset-0 -z-10 bg-[url('/Images/Contact/Sponza.png')] bg-cover bg-center opacity-25 dark:opacity-25"></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-bg/60 via-bg/80 to-bg"></div>

        <div class="wrap flex-1 flex flex-col justify-center py-20">
            <p class="eyebrow mb-6">Contact</p>
            <h1 class="text-5xl md:text-7xl font-semibold tracking-[-0.035em] leading-[1.02]">Get in touch</h1>
            <p class="lead mt-8 max-w-2xl">
                Questions about Synapse Engine, research collaboration, using the engine in a course or a thesis, or just
                graphics programming. Email is the most reliable way to reach me.
            </p>

            <!-- Email -->
            <div class="mt-12 rounded-lg border border-line bg-bg/70 backdrop-blur-sm p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="min-w-0">
                    <p class="eyebrow mb-2">Email</p>
                    <a href={`mailto:${EMAIL}`} class="block font-mono text-lg sm:text-2xl md:text-3xl text-fg break-all hover:underline underline-offset-8 decoration-line">{EMAIL}</a>
                </div>
                <div class="flex gap-3 shrink-0">
                    <a href={`mailto:${EMAIL}`} class="btn-primary">Send an email</a>
                    <button type="button" data-copy={EMAIL} class="btn-secondary">
                        <span data-copy-label>Copy</span>
                    </button>
                </div>
            </div>

            <!-- Other channels -->
            <div class="mt-6 grid gap-px bg-line border border-line rounded-lg overflow-hidden grid-cols-2 lg:grid-cols-4">
                {channels.map((c) => {
                    const inner = (
                        <>
                            <svg class="h-5 w-5 mb-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={c.icon} /></svg>
                            <span class="block text-sm text-faint">{c.label}</span>
                            <span class:list={['block mt-1', c.href ? 'text-fg' : 'text-faint']}>{c.value}</span>
                        </>
                    );
                    return c.href ? (
                        <a href={c.href} target="_blank" rel="noopener" class="group relative bg-bg/70 backdrop-blur-sm p-6 hover:bg-surface transition-colors text-muted hover:text-fg">
                            {inner}
                            <span class="absolute top-6 right-6 text-faint group-hover:text-fg transition-colors">↗</span>
                        </a>
                    ) : (
                        <div class="bg-bg/70 backdrop-blur-sm p-6 text-faint">{inner}</div>
                    );
                })}
            </div>
        </div>
    </section>

    <!-- ============================== REASONS ============================== -->
    <section class="border-t border-line bg-surface -mb-24">
        <div class="wrap py-20 md:py-24">
            <h2 class="h-sub mb-10">What you can write to me about</h2>
            <div class="grid md:grid-cols-3 border-t border-line md:divide-x divide-line">
                {reasons.map((r, i) => (
                    <div class:list={['pt-8 pb-2 md:px-8', i === 0 && 'md:pl-0', i === reasons.length - 1 && 'md:pr-0', i > 0 && 'border-t md:border-t-0 border-line mt-8 md:mt-0']}>
                        <p class="font-mono text-xs uppercase tracking-[0.12em] text-faint mb-5">{r.tag}</p>
                        <h3 class="text-lg font-semibold mb-3">{r.title}</h3>
                        <p class="body text-[15px]">{r.text}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <script>
        document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const label = btn.querySelector('[data-copy-label]');
                try {
                    await navigator.clipboard.writeText(btn.dataset.copy ?? '');
                    if (label) label.textContent = 'Copied';
                } catch {
                    if (label) label.textContent = 'Copy failed';
                }
                setTimeout(() => { if (label) label.textContent = 'Copy'; }, 1800);
            });
        });
    </script>
</Layout>
