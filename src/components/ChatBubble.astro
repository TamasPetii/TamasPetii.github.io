---
interface Props {
    isOwnMessage?: boolean;
    author: string;
    timestamp: string;
}

const { isOwnMessage = true, author, timestamp } = Astro.props;
---

<div class:list={['not-prose flex w-full mb-6', isOwnMessage ? 'justify-end' : 'justify-start']}>
    <div class:list={['flex flex-col min-w-0 max-w-[95%] md:max-w-[82%]', isOwnMessage ? 'items-end' : 'items-start']}>
        <span class="mb-1.5 px-1 max-w-full truncate font-mono text-[11px] text-faint">
            {author} · {timestamp}
        </span>
        <div class:list={[
            'max-w-full px-5 py-4 rounded-lg border border-line text-fg',
            isOwnMessage ? 'bg-surface' : 'bg-bg',
        ]}>
            <div class="space-y-3 text-sm md:text-[15px] leading-relaxed min-w-0">
                <slot />
            </div>
        </div>
    </div>
</div>
