---
interface Props {
    isOwnMessage?: boolean;
    author: string;
    timestamp: string;
}

const { isOwnMessage = true, author, timestamp } = Astro.props;
---

<div class={`flex w-full ${isOwnMessage ? 'justify-end' : 'justify-start'} mb-8 not-prose`}>
    <div class={`flex flex-col max-w-[95%] md:max-w-[80%] ${isOwnMessage ? 'items-end' : 'items-start'}`}>
        <span class="text-xs text-gray-500 dark:text-gray-400 mb-1 font-medium px-1">
            {author} • {timestamp}
        </span>
        
        <div class={`px-5 py-4 shadow-sm ${
            isOwnMessage 
            ? 'bg-purple-600 text-white rounded-2xl rounded-tr-sm' 
            : 'bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-2xl rounded-tl-sm border border-gray-200 dark:border-gray-700'
        }`}>
            <div class="space-y-3 font-sans text-sm md:text-base">
                <slot />
            </div>
        </div>
    </div>
</div>