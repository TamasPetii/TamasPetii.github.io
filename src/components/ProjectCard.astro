---
interface Props {
	title: string;
	description: string;
	tags: string[];
	link: string;
}
const { title, description, tags, link } = Astro.props;
---

<a href={link} class="group block border-t border-line pt-5 pb-2">
	<h3 class="text-lg font-semibold mb-2 group-hover:underline underline-offset-4 decoration-line">{title}</h3>
	<p class="text-sm leading-relaxed text-muted mb-3">{description}</p>
	<p class="font-mono text-xs text-faint">{tags.join(' · ')}</p>
</a>
