---
interface Props {
	title: string;
	description: string;
	tags: string[];
	link: string;
}
const { title, description, tags, link } = Astro.props;
---

<a href={link} class="group block p-6 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl hover:border-purple-500 dark:hover:border-purple-500 transition-all duration-300 hover:-translate-y-1 shadow-sm hover:shadow-[0_0_30px_rgba(168,85,247,0.15)]">
	<h3 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">{title}</h3>
	<p class="text-gray-600 dark:text-gray-400 mb-4">{description}</p>
	<div class="flex flex-wrap gap-2">
		{tags.map((tag) => (
			<span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-sm rounded-full text-gray-700 dark:text-gray-300">{tag}</span>
		))}
	</div>
</a>