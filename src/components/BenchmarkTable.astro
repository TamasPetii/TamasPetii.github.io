---
interface Props {
    title: string;
    rawText: string;
}

const { title, rawText } = Astro.props;
---

<figure class="not-prose my-8 border border-line rounded-lg overflow-hidden">
    <figcaption class="px-5 py-3 border-b border-line bg-surface font-mono text-xs uppercase tracking-wider text-muted">{title}</figcaption>
    <div class="p-5 overflow-x-auto">
        <pre class="m-0 text-xs sm:text-sm font-mono text-fg"><code>{rawText}</code></pre>
    </div>
</figure>
