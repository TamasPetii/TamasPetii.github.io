---
/** Grid for blog images. Usage in MDX: <Gallery cols={3}> <Shot ... /> ... </Gallery> */
interface Props {
    cols?: 1 | 2 | 3 | 4;
}
const { cols = 3 } = Astro.props;
const colClass = {
    1: '',
    2: 'sm:grid-cols-2',
    3: 'sm:grid-cols-2 lg:grid-cols-3',
    4: 'sm:grid-cols-2 lg:grid-cols-4',
}[cols];
---
<div class:list={['not-prose my-10 grid gap-x-6 gap-y-8', colClass]}>
    <slot />
</div>
