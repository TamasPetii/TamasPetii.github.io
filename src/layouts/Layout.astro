---
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
    /** Use the wider page container (devblog posts). */
    wide?: boolean;
}
const {
    title,
    wide = false,
    description = 'Synapse Engine – an open-source, research- and education-oriented GPU-driven game engine by Tamás Péter.',
} = Astro.props;
const pathname = Astro.url.pathname;
const container = wide ? 'wrap-wide' : 'wrap';

const nav = [
    { href: '/', label: 'Engine', active: pathname === '/' },
    { href: '/devblog', label: 'Devblog', active: pathname.startsWith('/devblog') },
    { href: '/about', label: 'About', active: pathname.startsWith('/about') },
    { href: '/contact', label: 'Contact', active: pathname.startsWith('/contact') },
    { href: '/sponsors', label: 'Sponsor', active: pathname.startsWith('/sponsors') },
];
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <!-- Browser tab icon follows the OS / browser theme -->
        <link rel="icon" type="image/svg+xml" href="/Icons/synapse-engine-icon-black.svg" media="(prefers-color-scheme: light)" />
        <link rel="icon" type="image/svg+xml" href="/Icons/synapse-engine-icon-white.svg" media="(prefers-color-scheme: dark)" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
        <title>{title}</title>
        <script is:inline>
            (() => {
                let theme = 'dark';
                try { theme = localStorage.getItem('theme') || 'dark'; } catch (e) {}
                document.documentElement.classList.toggle('dark', theme !== 'light');
            })();
        </script>
    </head>
    <body class="min-h-screen flex flex-col">

        <header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur">
            <div class:list={[container, 'flex h-16 items-center justify-between']}>
                <a href="/" class="flex items-center gap-2.5">
                    <img src="/Icons/synapse-engine-icon-black.svg" alt="" class="h-7 w-7 dark:hidden" />
                    <img src="/Icons/synapse-engine-icon-white.svg" alt="" class="h-7 w-7 hidden dark:block" />
                    <span class="text-[15px] font-semibold tracking-tight">Synapse Engine</span>
                </a>

                <nav class="hidden md:flex items-center gap-7">
                    {nav.map((item) => (
                        <a href={item.href}
                           class:list={[
                               'text-sm transition-colors',
                               item.active ? 'text-fg font-medium' : 'text-muted hover:text-fg',
                           ]}>
                            {item.label}
                        </a>
                    ))}
                    <a href="https://github.com/TamasPetii/SynapseEngine" target="_blank" rel="noopener" class="text-sm text-muted hover:text-fg transition-colors">GitHub</a>
                    <button data-theme-toggle aria-label="Toggle color theme" class="ml-1 p-1.5 rounded-md text-muted hover:text-fg hover:bg-surface transition-colors">
                        <svg class="hidden dark:block h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                        <svg class="block dark:hidden h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linejoin="round" d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
                    </button>
                </nav>

                <div class="flex md:hidden items-center gap-1">
                    <button data-theme-toggle aria-label="Toggle color theme" class="p-2 rounded-md text-muted hover:text-fg">
                        <svg class="hidden dark:block h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                        <svg class="block dark:hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linejoin="round" d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
                    </button>
                    <button id="mobile-menu-button" aria-label="Open menu" aria-expanded="false" class="p-2 rounded-md text-muted hover:text-fg">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
                    </button>
                </div>
            </div>

            <div id="mobile-menu" class="hidden md:hidden border-t border-line">
                <div class:list={[container, 'py-3 flex flex-col']}>
                    {nav.map((item) => (
                        <a href={item.href}
                           class:list={[
                               'py-2.5 text-base',
                               item.active ? 'text-fg font-medium' : 'text-muted',
                           ]}>
                            {item.label}
                        </a>
                    ))}
                    <a href="https://github.com/TamasPetii/SynapseEngine" target="_blank" rel="noopener" class="py-2.5 text-base text-muted">GitHub</a>
                </div>
            </div>
        </header>

        <main class="flex-grow">
            <slot />
        </main>

        <footer class="border-t border-line mt-24">
            <div class:list={[container, 'py-12 grid gap-10 sm:grid-cols-2 md:grid-cols-4 text-sm']}>
                <div class="md:col-span-2">
                    <div class="flex items-center gap-2.5 mb-3">
                        <img src="/Icons/synapse-engine-icon-black.svg" alt="" class="h-6 w-6 dark:hidden" />
                        <img src="/Icons/synapse-engine-icon-white.svg" alt="" class="h-6 w-6 hidden dark:block" />
                        <span class="font-semibold">Synapse Engine</span>
                    </div>
                    <p class="text-muted max-w-sm leading-relaxed">
                        An open-source, research- and education-oriented GPU-driven engine.
                        Developed at the Budapest University of Technology and Economics.
                    </p>
                </div>
                <div>
                    <div class="eyebrow mb-3">Site</div>
                    <ul class="space-y-2 text-muted">
                        <li><a href="/" class="hover:text-fg">Engine</a></li>
                        <li><a href="/devblog" class="hover:text-fg">Devblog</a></li>
                        <li><a href="/about" class="hover:text-fg">About</a></li>
                        <li><a href="/sponsors" class="hover:text-fg">Sponsor</a></li>
                    </ul>
                </div>
                <div>
                    <div class="eyebrow mb-3">Elsewhere</div>
                    <ul class="space-y-2 text-muted">
                        <li><a href="https://github.com/TamasPetii/SynapseEngine" target="_blank" rel="noopener" class="hover:text-fg">GitHub</a></li>
                        <li><a href="https://www.linkedin.com/in/tamaspeti/" target="_blank" rel="noopener" class="hover:text-fg">LinkedIn</a></li>
                        <li><a href="https://x.com/SynapseEngine" target="_blank" rel="noopener" class="hover:text-fg">X / Twitter</a></li>
                        <li><a href="mailto:contact@synapseengine.dev" class="hover:text-fg">contact@synapseengine.dev</a></li>
                    </ul>
                </div>
            </div>
            <div class:list={[container, 'pb-10 text-xs text-faint']}>© 2026 Tamás Péter</div>
        </footer>

        <script>
            const btn = document.getElementById('mobile-menu-button');
            const menu = document.getElementById('mobile-menu');
            btn?.addEventListener('click', () => {
                const open = menu?.classList.toggle('hidden') === false;
                btn.setAttribute('aria-expanded', String(open));
            });

            document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
                el.addEventListener('click', () => {
                    const dark = document.documentElement.classList.toggle('dark');
                    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
                    window.dispatchEvent(new CustomEvent('themechange', { detail: { dark } }));
                });
            });
        </script>
    </body>
</html>
