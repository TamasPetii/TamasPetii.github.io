---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('devblog'))
    .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
const { frontmatter } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<Layout title={`${frontmatter.title} | Synapse Engine Devblog`} description={frontmatter.description} wide>
    <div class="wrap-wide pt-12 md:pt-16 grid gap-12 xl:gap-16 lg:grid-cols-[14rem_minmax(0,1fr)]">

        <aside class="order-2 lg:order-1">
            <div class="lg:sticky lg:top-24">
                <a href="/devblog" class="text-sm text-muted hover:text-fg">← All posts</a>
                <p class="eyebrow mt-8 mb-3">Contents</p>
                <nav class="flex flex-col">
                    {allPosts.map((post, index) => {
                        const slug = post.id.replace(/\.[^/.]+$/, '');
                        const isActive = currentPath === `/devblog/${slug}`;
                        return (
                            <a href={`/devblog/${slug}`}
                               class:list={[
                                   'border-l py-1.5 pl-3 text-sm transition-colors',
                                   isActive ? 'border-fg text-fg' : 'border-line text-muted hover:text-fg',
                               ]}>
                                <span class="font-mono text-xs text-faint mr-2">{String(index + 1).padStart(2, '0')}</span>{post.data.title}
                            </a>
                        );
                    })}
                </nav>
            </div>
        </aside>

        <article class="order-1 lg:order-2 min-w-0 max-w-[62rem]">
            <header class="mb-10 pb-8 border-b border-line">
                <p class="eyebrow mb-4">{frontmatter.pubDate} · {frontmatter.tags.join(' · ')}</p>
                <h1 class="text-3xl md:text-5xl font-semibold tracking-[-0.03em] leading-[1.08]">{frontmatter.title}</h1>
                {frontmatter.description && <p class="lead mt-5 max-w-3xl">{frontmatter.description}</p>}
            </header>

            <div class="prose prose-neutral dark:prose-invert max-w-none
                        prose-headings:font-semibold prose-headings:tracking-tight
                        prose-p:text-muted prose-li:text-muted prose-p:leading-relaxed
                        prose-a:text-fg prose-a:underline-offset-4 prose-a:decoration-line hover:prose-a:decoration-fg
                        prose-strong:text-fg
                        prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-code:bg-surface prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                        prose-pre:bg-surface prose-pre:text-fg prose-pre:border prose-pre:border-line prose-pre:rounded-lg
                        prose-img:rounded-lg prose-img:border prose-img:border-line
                        prose-th:text-faint prose-th:font-mono prose-th:text-xs prose-th:font-normal prose-th:uppercase prose-th:tracking-wider
                        prose-td:text-muted prose-td:tabular-nums">
                <slot />
            </div>

            <section class="mt-20 pt-10 border-t border-line">
                <h2 class="h-sub mb-6">Comments</h2>
                <div class="giscus"></div>
            </section>
        </article>
    </div>

    <script>
        // Giscus follows the site theme (and re-syncs when it is toggled).
        const giscusTheme = () => (document.documentElement.classList.contains('dark') ? 'dark' : 'light');

        const s = document.createElement('script');
        s.src = 'https://giscus.app/client.js';
        s.async = true;
        s.crossOrigin = 'anonymous';
        Object.entries({
            'data-repo': 'TamasPetii/SynapseEngine',
            'data-repo-id': 'R_kgDON8I43g',
            'data-category': 'Announcements',
            'data-category-id': 'DIC_kwDON8I43s4DELfB',
            'data-mapping': 'pathname',
            'data-strict': '0',
            'data-reactions-enabled': '1',
            'data-emit-metadata': '0',
            'data-input-position': 'bottom',
            'data-theme': giscusTheme(),
            'data-lang': 'en',
        }).forEach(([k, v]) => s.setAttribute(k, v));
        document.querySelector('.giscus')?.after(s);

        window.addEventListener('themechange', () => {
            const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
            frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: giscusTheme() } } }, 'https://giscus.app');
        });
    </script>
</Layout>
